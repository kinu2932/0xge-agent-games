# Agent Games — Proof Gatekeeper agent (0xge)
# Copy to .env and fill in. NEVER commit .env.

# Public HTTPS endpoint port (fly.io sets PORT automatically).
PORT=8080
HOST=0.0.0.0

# HMAC secret for the x-agent-games-signature header.
# MUST be the platform-generated value from the Agent Games dashboard
# ("Rotate Secret"). Never a local placeholder, never commit it.
AGENT_HMAC_SECRET=

# Kurier (zkVerify proof verification, REST). Get the API key and base URL
# from the Kurier dashboard (linked from https://agentgames.zkverify.io/build).
# Both are required for APPROVE decisions: verification must reach Finalized
# before the agent approves. If unset, the agent fails closed (REJECT).
KURIER_API_KEY=
KURIER_BASE_URL=

# Gatekeeper circuit verification-key hash (registered on zkVerify mainnet).
# Served as JSON from https://agentgames.zkverify.io/api/circuit-info
# and recorded in circuits/README.md. Do not change unless the platform does.
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Optional override for the signal-mapping file (default
# circuits/gatekeeper.signals.json). Mostly useful for tests.
# GATEKEEPER_SIGNALS_PATH=./circuits/gatekeeper.signals.json

# Proof generation mode:
#   off     — do not generate a response proof (decision + verification only)
#   local   — generate a Groth16 proof locally with snarkjs (needs
#             circuits/gatekeeper.signals.json configured, see docs/)
PROOF_MODE=off

# Max time (ms) the agent may spend on one task. Hard platform deadline is
# 60_000 ms; keep a safety margin so the response is always on time.
TASK_TIMEOUT_MS=45000

# Timestamp skew allowed for incoming tasks (ms).
TIMESTAMP_SKEW_MS=300000

# Where used-proof references are persisted (replay protection).
USED_PROOFS_FILE=./data/used-proofs.json

LOG_LEVEL=info
